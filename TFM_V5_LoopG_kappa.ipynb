   "source": [
    "# 2.3 Cálculo de D_values sobre toda la malla z\n",
    "D_values = D(z)\n",
    "\n",
    "# 2.4 Cálculo de D_eff (promedio armónico), que también se usa en tau = t * D_eff / d^2\n",
    "integral_D = np.trapezoid(1.0 / D_values, z)\n",
    "D_eff = L / integral_D"
   ]

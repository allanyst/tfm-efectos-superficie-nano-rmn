    "##############################################################################\n",
    "# 5. Término Temporal T(t)\n",
    "##############################################################################\n",
    "# Ahora, para cada eigenvalor (de la parte axial) usaremos el valor absoluto\n",
    "# para que T(t)=exp(-|λ| t) decaiga.\n",
    "def T(t, lam):\n",
    "    return np.exp(-lam * t)\n",
    "\n",
    "# Graficamos T(t) para los modos del sistema axial\n",
    "plt.figure(figsize=(7.5,5))\n",
    "t_plot = np.logspace(-1, 4, 100)\n",
    "for n in range(min(4,n_modes_radial)):\n",
    "    for m in range(min(4, m_max)):\n",
    "        lam = eigenvalues_ax[n,m]\n",
    "        plt.loglog(t_plot, T(t_plot, lam), label=f\"n={n}, m={m}\", linewidth=1.5)\n",
    "plt.xlabel(r\"Tiempo ($\\mu$s)\", fontsize=12)\n",
    "plt.ylabel(\"T(t)\", fontsize=12)\n",
    "plt.ylim(1e-10,1e1)\n",
    "plt.title(\"Decaimiento Temporal T(t)\", fontsize=14)\n",
    "plt.legend()\n",
    "plt.grid(True, which=\"both\")\n",
    "plt.savefig(\"figuras/T_t_tworegion_z'.pdf\", bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close()"
   ]
  },

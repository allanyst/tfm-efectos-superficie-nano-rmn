    "##############################################################################\n",
    "# 6. Cálculo de Coeficientes A_{nm}\n",
    "##############################################################################\n",
    "# Se asume que la condición inicial es:\n",
    "#     P(ρ, z, 0) ∝ δ(ρ-ρ0) δ(z-z0) / (2πρ0)\n",
    "# Con ρ0 = 750 nm y z0 = 10 nm.\n",
    "# --- Parámetros de la delta ---\n",
    "rho0, z0 = 0.0,  0.0  # centro (nm)\n",
    "\n",
    "# --- 1) Mallado de cuadratura cilíndrica (ρ, z) ---\n",
    "N_quad = 1000\n",
    "rho_quad = np.linspace(0.0, R, N_quad)   # nodos radiales\n",
    "z_quad   = np.linspace(0.0, L, N_quad)   # nodos axiales\n",
    "\n",
    "# (1) Evaluar modos radiales en rho0:\n",
    "#     R_func(alpha_n, x) devuelve R_mat[n,i] = R_n(x)\n",
    "#     Usamos un punto x = rho0\n",
    "a0 = np.array([rho0])                       # array de un punto\n",
    "R0, _ = R_func(alpha_n, a0)                # R0.shape = (n_modes_radial, 1)\n",
    "R0 = R0[:, 0]                              # ahora vector (n_modes_radial,)\n",
    "\n",
    "# (2) Evaluar modos axiales en z0\n",
    "def eval_Z_at(z_val):\n",
    "    Z0 = np.empty((n_modes_radial, m_max))\n",
    "    for n in range(n_modes_radial):\n",
    "        for m in range(m_max):\n",
    "            Z0[n, m] = fz(z0,n,m)\n",
    "    return Z0\n",
    "\n",
    "Z0 = eval_Z_at(z0)  # Z0.shape = (n_modes_radial, m_max)\n",
    "\n",
    "# (4) Coeficientes modal A_nm: producto de R0 y Z0\n",
    "#     A_nm_delta[n,m] = R_n(rho0) * Z_{n,m}(z0)\n",
    "A_nm = R0[:, None] * Z0            # shape (n_modes_radial, m_max)\n",
    "print(f\"A_nm_delta shape: {A_nm.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "6c2c2bfc-251f-42f5-9b1a-6b26d50e3564",
   "metadata": {},
   "outputs": [],
   "source": [
    "##############################################################################\n",
    "## # 7. Densidad de Probabilidad P(ρ,z,t)\n",
    "##############################################################################\n",
    "rho_nodes = np.linspace(0.0, R, 1000)\n",
    "z_nodes = np.linspace(0.0, L, 1000)\n",
    "\n",
    "# Precompute Bessel J0 for all radial modes and rho\n",
    "# J0_mat shape: (n_modes, Nr)\n",
    "R0_mat,_ = R_func(alpha_n, rho_nodes)\n",
    "\n",
    "# Precompute axial modes Z_tens: shape (Nz, n_modes, m_max)\n",
    "Nz = len(z_nodes)\n",
    "n_modes, m_max = eigenvalues_ax.shape\n",
    "Z_tens = np.zeros((Nz, n_modes, m_max))\n",
    "for n in range(n_modes):\n",
    "    for m in range(m_max):\n",
    "        Z_tens[:, n, m] = fz(z_nodes, n, m)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "59ee525a-b33d-4478-a12c-f39b3c06cb76",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_P_vec(t, eigenvalues_ax, Z_tens, R0_mat, A_nm):\n",
    "    \"\"\"\n",
    "    Vectorized computation of P(rho, z, t).\n",
    "    \n",
    "    Parameters:\n",
    "    - t:        scalar time\n",
    "\n",
    "    Returns:\n",
    "    - P: 2D array of shape (Nz, Nr)\n",
    "    \"\"\"\n",
    "    \n",
    "    # Temporal decay T: shape (n_modes, m_max)\n",
    "    T_decay = np.exp(-eigenvalues_ax * t)\n",
    "    # Combine coefficients with normalization and decay: shape (n_modes, m_max)\n",
    "    W = A_nm * T_decay\n",
    "    \n",
    "    # Sum over axial modes m → B shape (Nz, n_modes)\n",
    "    B = np.sum(Z_tens * W[None, :, :], axis=2)\n",
    "    \n",
    "    # Combine with radial modes → S shape (Nr, Nz)\n",
    "    # J0_mat.T: (Nr, n_modes), B.T: (n_modes, Nz)\n",
    "    S = np.dot(R0_mat.T, B.T)\n",
    "    \n",
    "    # Return absolute value, shaped back to (Nz, Nr)\n",
    "    return np.maximum(S.T,0)"
   ]
  },

    "# Vector de tiempos\n",
    "t_values = np.logspace(-4, 7, N_quad)\n",
    "tau_values = D_eff * t_values / d**2\n",
    "\n",
    "# 1) Coeficientes de proyección de f sobre los modos: Cproj_nm\n",
    "#    Cproj_nm[n,m] = ∫ ρ dρ dz' f(ρ,z') R_n(ρ) Z_{n,m}(z')\n",
    "n_modes, m_max = eigenvalues_ax.shape\n",
    "Cproj_nm = np.zeros_like(eigenvalues_ax)   # (n_modes_radial, m_max)\n",
    "\n",
    "for n in range(n_modes):\n",
    "    # g_n(z_k) = ∑_i R_n(ρ_i) F(ρ_i, z_k)\n",
    "    g_n = np.dot(R0_mat[n, :], F)          # (Nz,)\n",
    "    for m in range(m_max):\n",
    "        # Z_tens tiene shape (Nz, n_modes, m_max)\n",
    "        Cproj_nm[n, m] = np.dot(g_n, Z_tens[:, n, m])\n",
    "\n",
    "# 2) G(t) = (5 / 16π) ∑_{n,m} Cproj_nm^2 e^{-λ_{nm} t}\n",
    "G_values = np.zeros_like(t_values)\n",
    "for i, t_val in enumerate(t_values):\n",
    "    T_decay = T(t_val, eigenvalues_ax)     # misma T(t, λ) definida en la celda 18\n",
    "    G_values[i] = (5.0/(16.0*np.pi)) * np.sum((Cproj_nm**2) * T_decay)\n"
   ]

    "G_dict      = {}\n",
    "weights_dict = {}\n",
    "\n",
    "for modes in modes_list:\n",
    "    print(f\"--- Truncando a {modes} modos ---\")\n",
    "\n",
    "    # 1) Subconjuntos de autovalores y coeficientes de proyección\n",
    "    evals_sub    = eigenvalues_ax[:modes, :modes]   # (modes, modes)\n",
    "    Cproj_sub    = Cproj_nm[:modes, :modes]         # (modes, modes)\n",
    "\n",
    "    # 2) Calcular G(t) con la suma espectral truncada\n",
    "    G_vals = np.zeros_like(t_values)\n",
    "    for i, t in enumerate(t_values):\n",
    "        T_decay = T(t, evals_sub)                  # (modes, modes)\n",
    "        G_vals[i] = (5.0/(16.0*np.pi)) * np.sum((Cproj_sub**2) * T_decay)\n",
    "    G_dict[modes] = G_vals\n",
    "\n",
    "    # 3) Pesos modales normalizados (aportación relativa a G)\n",
    "    w = (Cproj_sub**2).flatten()\n",
    "    weights_dict[modes] = w / np.sum(w)\n"
   ]

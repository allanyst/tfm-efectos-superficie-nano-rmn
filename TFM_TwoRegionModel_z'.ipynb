    "##############################################################################\n",
    "# 1. Solución Radial R(ρ)\n",
    "##############################################################################\n",
    "\n",
    "def D_eff_tworegion(D1, D2, z_c, L):\n",
    "    L1, L2 = z_c, L - z_c\n",
    "    return (L1 + L2) / (L1/D1 + L2/D2)\n",
    "\n",
    "D_eff=D_eff_tworegion(D1, D2, z_c, L)\n",
    "D_eff"
   ]

    "    E.append(err)\n",
    "    labels.append(f\"{m0}→{m1}\")\n",
    "E = np.array(E)\n",
    "\n",
    "# 3.2. Prepara los “bin edges” de tiempo en log\n",
    "#    pcolormesh necesita los bordes de las celdas:\n",
    "tau_edges = np.logspace(np.log10(tau_values[0]), np.log10(tau_values[-1]), len(tau_values)+1)\n",

    "##############################################################################\n",
    "# 8. Función de Correlación G(t) – versión correcta\n",
    "##############################################################################\n",
    "\n",
    "dr = rho_nodes[1] - rho_nodes[0]\n",
    "dz = z_nodes[1] - z_nodes[0]\n",
    "\n",
    "# Factor dipolar f(ρ,z') en la malla (Nr, Nz)\n",
    "R2 = rho_nodes**2\n",
    "Z2 = (z_nodes + d)**2   # distancia al NV: z' + d\n",
    "f_mat = (3*Z2[None, :] - R2[:, None]) / (R2[:, None] + Z2[None, :])**2.5  # (Nr, Nz)\n",
    "\n",
    "# Medida cilíndrica ρ dρ dz'\n",
    "measure = rho_nodes[:, None] * dr * dz    # (Nr, 1)\n",
    "\n",
    "# Matriz F(ρ,z') = ρ dρ dz' f(ρ,z')\n",
    "F = measure * f_mat                       # (Nr, Nz)\n"
   ]
  },

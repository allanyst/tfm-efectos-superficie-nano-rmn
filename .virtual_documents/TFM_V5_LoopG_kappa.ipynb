    arr = np.loadtxt(temp_filename, skiprows=1)   # forma (N_quad, 2)

    if primero:
        t_col = arr[:, 0]   # extraemos el vector de tiempos
        primero = False
    G_col = arr[:, 1]       # extraemos la columna G(t) para este kappa
    lista_Gcols.append(G_col)

# Después seguimos exactamente igual:
G_stack = np.vstack(lista_Gcols).T               # (N_quad, 8)
output_data = np.column_stack([t_col, G_stack])  # (N_quad, 1 + 8)

header_cols = ['Tiempo(s)'] + [f'G_k{int(kp*10)}' for kp in varkappa_list]
header_str = '   '.join(header_cols)

np.savetxt(
    "data/VariateKappa_G_vs_t.dat",
    output_data,
    header=header_str,
    fmt="%.9e",
    comments=''
)

print("→ Archivo final 'VariateKappa_G_vs_t.dat' creado con columnas:")
print("   ", header_cols)


df = pd.read_csv("data/VariateKappa_G_vs_t.dat",delim_whitespace=True,comment='#')


plt.figure(figsize=(7.5,5))
plt.loglog(tau_values, df.G_k0/df.G_k0[0], "o-", label=r"$\kappa=0.0$", markersize=0.5, linewidth=0.25)
plt.loglog(tau_values, df.G_k1/df.G_k1[0], "o-", label=r"$\kappa=0.1\,\text{nm/s}$", markersize=0.5, linewidth=0.25)
plt.loglog(tau_values, df.G_k10/df.G_k10[0], "o-", label=r"$\kappa=1.0\,\text{nm/s}$", markersize=0.5, linewidth=0.25)
plt.loglog(tau_values, df.G_k100/df.G_k100[0], "o-", label=r"$\kappa=10.0\,\text{nm/s}$", markersize=0.5, linewidth=0.25)
plt.loglog(tau_values, df.G_k1000/df.G_k1000[0], "o-", label=r"$\kappa=100.0\,\text{nm/s}$", markersize=0.5, linewidth=0.25)
plt.plot(tau_values[(tau_values>=2)&(tau_values<=1000)], tau_values[(tau_values>=2)&(tau_values<=1000)]**-1.5, "--", label=r"Teoría $(\tau)^{-3/2}$", color="crimson", linewidth=1.5)
plt.plot(tau_values[(tau_values>=1e-2)&(tau_values<=0.1)], np.exp(-6*tau_values[(tau_values>=1e-2)&(tau_values<=0.1)]), "--", label=r"Teoría $\exp(-6\tau)$", color="green", linewidth=1.5)
# plt.xlabel("Tiempo (s)", fontsize=12)
plt.xlabel(r"$\tau$", fontsize=12)
plt.ylabel(r"$\tilde{G}(\tau)$", fontsize=12)
plt.title("Función de Correlación Nano-NMR", fontsize=14)
plt.legend()
plt.ylim((1e-10,1e2))
plt.grid(which="both", ls='--', alpha=0.7)
plt.savefig("figuras/correlacion_nanoNMR_kappaVariation.pdf", bbox_inches="tight", dpi=300)
plt.show()
plt.close()

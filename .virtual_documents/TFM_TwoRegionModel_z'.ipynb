#     integrand = rho_factor * S  # (Nr, Nz) * (Nr, Nz)
    
#     G_values[i] = (5/(16*np.pi)) * np.sum(integrand)


# Vector de tiempos
t_values = np.logspace(-4, 7, N_quad)
tau_values = D_eff * t_values / d**2

# 1) Coeficientes de proyección de f sobre los modos: Cproj_nm
#    Cproj_nm[n,m] = ∫ ρ dρ dz' f(ρ,z') R_n(ρ) Z_{n,m}(z')
n_modes, m_max = eigenvalues_ax.shape
Cproj_nm = np.zeros_like(eigenvalues_ax)   # (n_modes_radial, m_max)

for n in range(n_modes):
    # g_n(z_k) = ∑_i R_n(ρ_i) F(ρ_i, z_k)
    g_n = np.dot(R0_mat[n, :], F)          # (Nz,)
    for m in range(m_max):
        # Z_tens tiene shape (Nz, n_modes, m_max)
        Cproj_nm[n, m] = np.dot(g_n, Z_tens[:, n, m])

# 2) G(t) = (5 / 16π) ∑_{n,m} Cproj_nm^2 e^{-λ_{nm} t}
G_values = np.zeros_like(t_values)
for i, t_val in enumerate(t_values):
    T_decay = T(t_val, eigenvalues_ax)     # misma T(t, λ) definida en la celda 18
    G_values[i] = (5.0/(16.0*np.pi)) * np.sum((Cproj_nm**2) * T_decay)



np.savetxt("data/G_vs_t_tworegion_z'.dat", np.c_[t_values, G_values], header="Tiempo(s) G(t)", fmt="%.9e")


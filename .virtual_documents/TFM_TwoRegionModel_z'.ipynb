##############################################################################
# 8. Función de Correlación G(t) – versión correcta
##############################################################################

dr = rho_nodes[1] - rho_nodes[0]
dz = z_nodes[1] - z_nodes[0]

# Factor dipolar f(ρ,z') en la malla (Nr, Nz)
R2 = rho_nodes**2
Z2 = (z_nodes + d)**2   # distancia al NV: z' + d
f_mat = (3*Z2[None, :] - R2[:, None]) / (R2[:, None] + Z2[None, :])**2.5  # (Nr, Nz)

# Medida cilíndrica ρ dρ dz'
measure = rho_nodes[:, None] * dr * dz    # (Nr, 1)

# Matriz F(ρ,z') = ρ dρ dz' f(ρ,z')
F = measure * f_mat                       # (Nr, Nz)



# t_values = np.logspace(-4, 7, N_quad)
# tau_values=D_eff*t_values/d**2
# G_values = np.zeros_like(t_values)

plt.plot(tau_values[(tau_values>=1)&(tau_values<=1000)], (tau_values[(tau_values>=1)&(tau_values<=1000)])**-1.5, "--", label=r"Teoría $(\tau)^{-3/2}$", color="crimson", linewidth=1.5)
# plt.xlabel("Tiempo (s)", fontsize=12)

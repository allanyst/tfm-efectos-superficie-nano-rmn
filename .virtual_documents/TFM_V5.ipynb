##############################################################################
# 7. Cálculo de Coeficientes A_{nm}
##############################################################################
# Se asume que la condición inicial es:
#     P(ρ, z, 0) ∝ δ(ρ-ρ0) δ(z-z0) / (2πρ0)

# --- Parámetros de la delta ---
rho0, z0 = 0.0,  d  # centro (nm)

# --- 1) Mallado de cuadratura cilíndrica (ρ, z) ---
N_quad = 1000
rho_quad = np.linspace(0.0, R, N_quad)   # nodos radiales
z_quad   = np.linspace(d, L+d, N_quad)   # nodos axiales

# (1) Evaluar modos radiales en rho0:
#     R_func(alpha_n, x) devuelve R_mat[n,i] = R_n(x)
#     Usamos un punto x = rho0
a0 = np.array([rho0])                       # array de un punto
R0, _ = R_func(alpha_n, a0)                # R0.shape = (n_modes_radial, 1)
R0 = R0[:, 0]                              # ahora vector (n_modes_radial,)

# (2) Construir splines axiales si no existen (z en nm)
#     Z_interps[n,m] interpola cada modo axial en [0, L]
Z_interps = np.empty((n_modes_radial, m_max), dtype=object)
for n in range(n_modes_radial):
    for m in range(m_max):
        Z_interps[n, m] = CubicSpline(z, eigenvectors_ax[n][m,:], extrapolate=False)

# (3) Evaluar modos axiales en z0
def eval_Z_at(z_val):
    Z0 = np.empty((n_modes_radial, m_max))
    for n in range(n_modes_radial):
        for m in range(m_max):
            Z0[n, m] = Z_interps[n, m](z_val)
    return Z0

Z0 = eval_Z_at(z0)  # Z0.shape = (n_modes_radial, m_max)

# (4) Coeficientes modal A_nm: producto de R0 y Z0
#     A_nm_delta[n,m] = R_n(rho0) * Z_{n,m}(z0)
A_nm = R0[:, None] * Z0            # shape (n_modes_radial, m_max)
print(f"A_nm_delta shape: {A_nm.shape}")





##############################################################################
# 8. Densidad de Probabilidad P(ρ,z,t)
##############################################################################
N_quad=1000
rho_nodes = np.linspace(0.0, R, N_quad)
z_nodes = np.linspace(d, L+d, N_quad)

# Precompute Bessel J0 for all radial modes and rho
# J0_mat shape: (n_modes, Nr)
R0_mat,_ = R_func(alpha_n, rho_nodes)

# Precompute axial modes Z_tens: shape (Nz, n_modes, m_max)

n_modes, m_max = eigenvalues_ax.shape
Z_tens = np.zeros((N_quad, n_modes, m_max))
for n in range(n_modes):
    for m in range(m_max):
        Z_tens[:, n, m] = Z_interps[n,m](z_nodes)


R0_mat, _ = R_func(alpha_n, rho_nodes)  # shape (n_modes_radial, Nr)


def compute_P_vec(t, eigenvalues_ax, Z_tens, R0_mat, A_nm):
    """
    Computa P(ρ,z,t) más rápido usando matrices precalculadas.

    Parámetros:
    - t: escalar de tiempo
    - Z_tens: shape (Nz, n_modes_radial, m_max)
    - R0_mat: shape (n_modes_radial, N_r)
    - A_nm: coeficientes modales (n_modes_radial, m_max)

    Devuelve:
    - P: shape (Nz, Nr)
    """
    T_decay = T(t, eigenvalues_ax)  # (n_modes, m_max)
    W = A_nm * T_decay               # (n_modes, m_max)
    B = np.sum(Z_tens * W[None, :, :], axis=2)  # (Nz, n_modes)
    S = np.dot(R0_mat.T, B.T)  # (Nr, Nz)
    return S.T # np.maximum(S.T, 0)


for t_val in [0,0.1,0.2,0.5,1,2,5,10,20,50,100]:
    P_val = compute_P_vec(t_val, eigenvalues_ax, Z_tens, R0_mat, A_nm)
    
    plt.figure(figsize=(7.5,5))
    plt.contourf(rho_nodes, z_nodes, P_val, 50, cmap="plasma")
    plt.xlabel("ρ (nm)", fontsize=12)
    plt.ylabel("z (nm)", fontsize=12)
    plt.title(f"Densidad P(ρ,z,t) para t = {t_val}", fontsize=14)
    plt.colorbar()
    plt.savefig(f"figuras/P_contour_{t_val}.pdf", bbox_inches="tight")
    plt.show()
    plt.close()





##############################################################################
# 8. Función de Correlación G(t)
##############################################################################

# dr = rho_nodes[1] - rho_nodes[0]
# dz = z_nodes[1] - z_nodes[0]

# # Precomputar factor dipolar
# R2 = rho_nodes**2
# Z2 = (z_nodes)**2
# f_mat = (3*Z2[None, :] - R2[:, None]) / (R2[:, None] + Z2[None, :])**2.5
# f0 = (3*(z0 + d)**2 - rho0**2) / ((z0 + d)**2 + rho0**2)**2.5
# rho_factor = (rho_nodes[:, None] * f0 * f_mat * dr * dz)


##############################################################################
# 8. Función de Correlación G(t) CORREGIDA
##############################################################################

dr = rho_nodes[1] - rho_nodes[0]
dz = z_nodes[1] - z_nodes[0]

# Factor de forma dipolar f(ρ,z) en la malla (mismo que antes, pero sin f0)
R2 = rho_nodes**2
Z2 = (z_nodes)**2
f_mat = (3*Z2[None, :] - R2[:, None]) / (R2[:, None] + Z2[None, :])**2.5
# f_mat.shape = (Nr, Nz)

# Medida ρ dρ dz en la malla
measure = rho_nodes[:, None] * dr * dz   # (Nr, 1)

# Matriz F(ρ,z) = ρ dρ dz f(ρ,z)
F = measure * f_mat                      # shape (Nr, Nz)

n_modes, m_max = eigenvalues_ax.shape    # ya lo tienes antes

# Coeficientes de proyección C_nm
C_nm = np.zeros((n_modes, m_max))

for n in range(n_modes):
    # Integración en ρ: g_n(z_k) = ∑_i R_n(ρ_i) F(ρ_i,z_k)
    g_n = np.dot(R0_mat[n, :], F)        # shape (Nz,)
    # Integración en z: C_nm = ∑_k g_n(z_k) Z_nm(z_k)
    for m in range(m_max):
        C_nm[n, m] = np.dot(g_n, Z_tens[:, n, m])



# t_values = np.logspace(-4, 7, N_quad)
# tau_values=D_eff*t_values/d**2
# G_values = np.zeros_like(t_values)
# for i,t_val in enumerate(t_values):
#     S=compute_P_vec(t_val, eigenvalues_ax, Z_tens, R0_mat, A_nm).T
#     integrand = rho_factor * S  # (Nr, Nz) * (Nr, Nz)
    
#     G_values[i] = (5/(16*np.pi)) * np.sum(integrand)

# np.savetxt("data/G_vs_t.dat", np.c_[t_values, G_values], header="Tiempo(s) G(t)", fmt="%.9e")


t_values = np.logspace(-4, 7, N_quad)
tau_values = D_eff * t_values / d**2
G_values = np.zeros_like(t_values)

for i, t_val in enumerate(t_values):
    T_decay = T(t_val, eigenvalues_ax)   # misma función T(t, λ) que ya definiste
    G_values[i] = (5/(16*np.pi)) * np.sum((C_nm**2) * T_decay)

np.savetxt("data/G_vs_t.dat",np.c_[t_values, tau_values, G_values],header="Tiempo(s) tau G(t)", fmt="%.9e")


plt.figure(figsize=(7.5,5))
plt.loglog(tau_values, G_values/G_values[0], "o-", label="Simulación", color="navy", markersize=1, linewidth=0.5)
plt.plot(tau_values[tau_values<0.5], np.exp(-6*tau_values[tau_values<0.5]), "--", label=r"Teoría $\exp(-6\tau)$", color="green", linewidth=1.5)
plt.plot(tau_values[(tau_values>=1)&(tau_values<=100)], (tau_values[(tau_values>=1)&(tau_values<=100)])**-1.5, "--", label=r"Teoría $(t/T_D)^{-3/2}$", color="crimson", linewidth=1.5)
# plt.xlabel("Tiempo (s)", fontsize=12)
plt.xlabel(r"$\tau$", fontsize=12)
plt.ylabel(r"$\tilde{G}(\tau)$", fontsize=12)
plt.title("Función de Correlación Nano-NMR", fontsize=14)

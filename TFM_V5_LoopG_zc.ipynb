    "# -----------------------------------------------------------------------------\n",
    "# 3. Definición de funciones compartidas:\n",
    "#    - robin_eq(alpha): ecuación trascendental radial con parámetro varkappa\n",
    "#    - R_func(alpha_array, rho_array): calcula los modos radiales J0(alpha_n * rho) normalizados\n",
    "#    - build_system(n): ensambla y diagonaliza la parte axial para un modo radial n\n",
    "# -----------------------------------------------------------------------------\n",
    "def robin_eq(alpha, D_eff):\n",
    "    \"\"\"\n",
    "    Ecuación trascendental radial para hallar raíces alpha_n:\n",
    "       alpha * J1(alpha*R) - (varkappa / D_eff) * J0(alpha*R) = 0.\n",
    "    \"\"\"\n",
    "    return alpha * jv(1, alpha * R) - (varkappa / D_eff) * jv(0, alpha * R)\n",
    "\n",
    "def find_alpha_roots(D_eff, n_roots=n_modes_radial, step=1e-4):\n",
    "    \"\"\"\n",
    "    Encuentra las primeras `n_roots` raíces alpha_n de robin_eq(alpha)=0\n",
    "    en intervalos [0, ...] usando brentq y un paso `step`.\n",
    "    \"\"\"\n",
    "    alpha_roots = []\n",
    "    alpha_current = 0.0\n",
    "    while len(alpha_roots) < n_roots:\n",
    "        try:\n",
    "            root = brentq(lambda a: robin_eq(a, D_eff),\n",
    "                          alpha_current, alpha_current + step, xtol=1e-6)\n",
    "            alpha_roots.append(root)\n",
    "            alpha_current = root + step\n",
    "        except ValueError:\n",
    "            alpha_current += step\n",
    "    return np.array(alpha_roots)\n",
    "\n",
    "def R_func(alpha_arr, rho_arr):\n",
    "    \"\"\"\n",
    "    Calcula los modos radiales normalizados R_n(rho) = J0(alpha_n * rho)/sqrt(norm_n).\n",
    "    Retorna:\n",
    "      - R_normed: array con forma (n_modes_radial, len(rho_arr))\n",
    "      - norms: vector con las normas (no se usa más adelante, pero lo dejamos para consistencia)\n",
    "    \"\"\"\n",
    "    # alpha_arr: (n_modes_radial,)\n",
    "    # rho_arr: (N_rhos,)\n",
    "    alpha = alpha_arr.reshape(-1, 1)   # forma (n_modes_radial, 1)\n",
    "    rho = rho_arr.reshape(1, -1)       # forma (1, N_rhos)\n",
    "    R_matrix = jv(0, alpha * rho)      # (n_modes_radial, N_rhos)\n",
    "\n",
    "    # Cálculo de normas analíticas: norms[n] = sqrt{ \\int_0^R rho J0^2(alpha_n rho) d rho }\n",
    "    J0R = jv(0, alpha_arr * R)  # (n_modes_radial,)\n",
    "    J1R = jv(1, alpha_arr * R)  # (n_modes_radial,)\n",
    "    norms = 0.5 * R ** 2 * (J0R**2 + J1R**2)  # (n_modes_radial,)\n",
    "    norms = np.atleast_1d(norms)\n",
    "    Nnorm = 1.0 / np.sqrt(norms)  # factor de normalización\n",
    "\n",
    "    R_normed = Nnorm[:, None] * R_matrix  # (n_modes_radial, N_rhos)\n",
    "    return R_normed, np.sqrt(norms)\n",
    "\n",
    "def build_system(n, alpha_n, D_values, z, h):\n",
    "    \"\"\"\n",
    "    Ensambla la matriz tridiagonal A para el modo radial n y la diagonaliza\n",
    "    para obtener m_max autovalores y autovectores.\n",
    "    - n: índice del modo radial (0 .. n_modes_radial-1)\n",
    "    - alpha_n: array con todas las raíces alpha (tamaño n_modes_radial)\n",
    "    - D_values: perfil D(z) evaluado en todos los nodos z (longitud N_z)\n",
    "    - z: malla en z (longitud N_z)\n",
    "    - h: diferencias entre nodos de z (longitud N_z-1)\n",
    "    - varkappa: valor actual de kappa en nm/s\n",
    "    Retorna: (n, (evals, evecs)), donde\n",
    "      - evals: vector de longitud m_max con los m_max autovalores más bajos\n",
    "      - evecs: matriz (N_z, m_max) con los vectores propios normalizados\n",
    "    \"\"\"\n",
    "    try:\n",
    "        alpha = alpha_n[n]\n",
    "        N = len(z)\n",
    "        main_diag = np.zeros(N)\n",
    "        upper_diag = np.zeros(N-1)\n",
    "        lower_diag = np.zeros(N-1)\n",
    "\n",
    "        # ---------------------------------------------------------------\n",
    "        # 1. Índices internos (j=1 a N-2)\n",
    "        # ---------------------------------------------------------------\n",
    "        j_int = np.arange(1, N-1)  # j=1, 2, ..., N-2\n",
    "        j_prev = j_int - 1         # j-1 = 0, 1, ..., N-3\n",
    "        j_next = j_int + 1         # j+1 = 2, 3, ..., N-1\n",
    "    \n",
    "        # ---------------------------------------------------------------\n",
    "        # 2. Cálculo de coeficientes (vectorizado)\n",
    "        # ---------------------------------------------------------------\n",
    "        # Promedios armónicos de D en interfases\n",
    "        D_prev = 2*D_values[j_int]*D_values[j_prev]/(D_values[j_int] + D_values[j_prev])  # D_{j-1/2}\n",
    "        D_next = 2*D_values[j_int]*D_values[j_next]/(D_values[j_int] + D_values[j_next])  # D_{j+1/2}\n",
    "        \n",
    "        # Espaciados promedio\n",
    "        h_m  = h[j_prev]                 # h_{j-1/2}\n",
    "        h_p  = h[j_int]                  # h_{j+1/2}\n",
    "        h_j  = 0.5 * (h_m + h_p)         # h_j\n",
    "    \n",
    "        # Términos de la matriz (simétricos)\n",
    "        main_diag[j_int] = (\n",
    "              D_prev / (h_m * h_j)    # coeficiente de Z_{j-1}\n",
    "            + D_next / (h_p * h_j)    # coeficiente de Z_{j+1}\n",
    "            + alpha**2 * D_values[j_int]\n",
    "        )\n",
    "        lower_diag[j_prev] = - D_prev / (h_m * h_j)      # A[j, j-1]\n",
    "        upper_diag[j_int]  = - D_next / (h_p * h_j)      # A[j, j+1]\n",
    "    \n",
    "        # ---------------------------------------------------------------\n",
    "        # 3. Condiciones de contorno - Simétricas\n",
    "        # ---------------------------------------------------------------\n",
    "        # Superficie (z = d)\n",
    "        h0 = h[0]\n",
    "        h_1_2=z[1]-z[0]\n",
    "        D0 = D_values[0]\n",
    "        D_1_2 = 2*D0*D_values[1]/(D0 + D_values[1])\n",
    "        \n",
    "        main_diag[0] = D_1_2/h0/h_1_2 + varkappa/h0 + alpha ** 2 * D0\n",
    "        upper_diag[0] = -D_1_2/h0/h_1_2\n",
    "        lower_diag[0] = upper_diag[0]\n",
    "        \n",
    "        # Borde superior (z = L + d)\n",
    "        hL = h[-1]\n",
    "        h_3_2=z[-1]-z[-2]\n",
    "        DL = D_values[-1]\n",
    "        D_3_2 = 2 * D_values[-1] * D_values[-2] / (D_values[-1] + D_values[-2])\n",
    "        \n",
    "        main_diag[-1] = D_3_2 / hL/h_3_2 + varkappa / hL + alpha ** 2 * DL\n",
    "        lower_diag[-2] = -D_3_2 / hL/h_3_2\n",
    "        upper_diag[-1] = lower_diag[-2]\n",
    "\n",
    "        # ---------------------------------------------------------------\n",
    "        # 4. Ensamblar matriz tridiagonal simétrica\n",
    "        # ---------------------------------------------------------------\n",
    "        A = diags(\n",
    "            diagonals=[main_diag, upper_diag, lower_diag],\n",
    "            offsets=[0, 1, -1],\n",
    "            shape=(N, N),\n",
    "            format='csr'\n",
    "        ) # + 1e-10 * identity(N)\n",
    "        evals, evecs = eigsh(A, k=m_max, sigma=0.0, which='LM', tol=1e-6, maxiter=10000)\n",
    "        if n==0 and varkappa==0:\n",
    "            evals[0]=0.0\n",
    "        else:\n",
    "            pass\n",
    "        return (n, (evals, evecs))\n",
    "\n",
    "    except ArpackNoConvergence:\n",
    "        print(f\"Advertencia: El modo axial para n={n} no convergió. Se devuelven ceros.\")\n",
    "        return (n, (np.zeros(m_max), np.zeros((len(z), m_max))))\n",
    "\n",
    "def T(t, lam):\n",
    "    return np.exp(-np.abs(lam) * t)\n",
    "\n",
    "def compute_P_vec(t, eigenvalues_ax, Z_tens, R0_mat, A_nm):\n",
    "    \"\"\"\n",
    "    Computa P(ρ,z,t) más rápido usando matrices precalculadas.\n",
    "\n",
    "    Parámetros:\n",
    "    - t: escalar de tiempo\n",
    "    - Z_tens: shape (Nz, n_modes_radial, m_max)\n",
    "    - R0_mat: shape (n_modes_radial, N_r)\n",
    "    - A_nm: coeficientes modales (n_modes_radial, m_max)\n",
    "\n",
    "    Devuelve:\n",
    "    - P: shape (Nz, Nr)\n",
    "    \"\"\"\n",
    "    T_decay = T(t, eigenvalues_ax)  # (n_modes, m_max)\n",
    "    W = A_nm * T_decay               # (n_modes, m_max)\n",
    "    B = np.sum(Z_tens * W[None, :, :], axis=2)  # (Nz, n_modes)\n",
    "    S = np.dot(R0_mat.T, B.T)  # (Nr, Nz)\n",
    "    return S.T # np.maximum(S.T, 0)"
   ]

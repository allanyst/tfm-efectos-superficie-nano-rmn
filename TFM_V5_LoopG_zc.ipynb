    "# -----------------------------------------------------------------------------\n",
    "# 2. Malla adaptativa en z y perfil D(z) (NO depende de varkappa)\n",
    "# -----------------------------------------------------------------------------\n",
    "# 2.1 Construcción de la malla en z\n",
    "j_vals = np.arange(N_z)\n",
    "z = d + L * np.sinh(alpha_grid * j_vals / (N_z - 1)) / np.sinh(alpha_grid)\n",
    "h = np.diff(z)  # h_j = z[j] - z[j-1]\n",
    "\n",
    "# 2.2 Definición de D(z) (función)\n",
    "def D(z_val,z_c):\n",
    "    \"\"\"\n",
    "    Perfil de difusión completo con z en nm:\n",
    "    D(z) = D_s + (D0 - D_s) * [ (1 - exp(-lambda_param*(z - d))) * (1 - S(z)) + S(z) ],\n",
    "    con S(z) = 0.5 * [1 + tanh( (z - (z_c + d)) / delta ) ].\n",
    "    \"\"\"\n",
    "    S = 0.5 * (1 + np.tanh((z_val - (z_c + d)) / delta))\n",
    "    return D_s + (D0 - D_s) * ((1 - np.exp(-lambda_param * (z_val - d))) * (1 - S) + S)"
   ]
  },

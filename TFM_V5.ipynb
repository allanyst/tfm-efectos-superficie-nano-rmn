    "##############################################################################\n",
    "# 2. Generación de la malla en z (nm)\n",
    "##############################################################################\n",
    "\n",
    "j_vals = np.arange(N_z)\n",
    "z=d+L* np.sinh(alpha_grid * j_vals / (N_z - 1)) / np.sinh(alpha_grid)\n",
    "\n",
    "plt.figure(figsize=(7.5,5))\n",
    "plt.plot(z[1:],np.diff(z))\n",
    "plt.xlabel(r\"$z$ (nm)\")\n",
    "plt.ylabel(r\"$\\Delta z$ (nm)\")\n",
    "plt.title(\"Paso de la malla adaptativa\")\n",
    "plt.grid(ls='--', alpha=0.7)\n",
    "plt.savefig('figuras/Grid.pdf', bbox_inches='tight')\n",
    "plt.show()\n",
    "plt.close()"
   ]

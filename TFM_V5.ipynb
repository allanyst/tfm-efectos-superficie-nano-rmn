    "G_dict = {}\n",
    "\n",
    "for modes in modes_list:\n",
    "    print(f\"--- Truncando a {modes} modos ---\")\n",
    "\n",
    "    # 1) Subconjuntos de datos (por si los sigues usando para otras cosas)\n",
    "    alpha_sub  = alpha_n[:modes]\n",
    "    evals_sub  = eigenvalues_ax[:modes, :modes]   # (modes, modes)\n",
    "    C_nm_sub   = C_nm[:modes, :modes]             # (modes, modes)\n",
    "\n",
    "    # 2) Calcular G(t) con la expresión espectral correcta\n",
    "    G_vals = np.zeros_like(t_values)\n",
    "    for i, t in enumerate(t_values):\n",
    "        T_decay = T(t, evals_sub)                # mismos shapes que evals_sub\n",
    "        G_vals[i] = (5/(16*np.pi)) * np.sum((C_nm_sub**2) * T_decay)\n",
    "\n",
    "    G_dict[modes] = G_vals"
   ]

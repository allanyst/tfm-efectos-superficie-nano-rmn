    "# Estimar raíces con brentq en intervalos [a, b] con cambio de signo\n",
    "alpha_min = 0.0\n",
    "alpha_n = []\n",
    "step = 0.0001  # Paso inicial para buscar raíces\n",
    "\n",
    "alpha_current = alpha_min\n",
    "while len(alpha_n) < n_modes_radial:\n",
    "    # Buscar raíces en el intervalo [Lambda_current, Lambda_current + step]\n",
    "    try:\n",
    "        root = brentq(robin_eq, alpha_current, alpha_current + step, xtol=1e-6)\n",
    "        alpha_n.append(root)\n",
    "        alpha_current = root + step  # Mover el inicio para la próxima búsqueda\n",
    "    except ValueError:\n",
    "        alpha_current += step\n",
    "alpha_n=np.array(alpha_n)"

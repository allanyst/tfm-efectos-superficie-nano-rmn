    "# 3.1. Construye la matriz de errores E (shape N_pairs × N_t)\n",
    "E = []\n",
    "labels = []\n",
    "for i in range(len(modes_list)-1):\n",
    "    m0, m1 = modes_list[i], modes_list[i+1]\n",
    "    err = np.abs(G_dict[m0]/G_dict[m0][0] - G_dict[m1]/G_dict[m1][0]) / (G_dict[m1]/G_dict[m1][0]) * 100\n",
    "    E.append(err)\n",
    "    labels.append(f\"{m0}→{m1}\")\n",
    "E = np.array(E)\n",
    "\n",
    "# 3.2. Prepara los “bin edges” de tiempo en log\n",
    "#    pcolormesh necesita los bordes de las celdas:\n",
    "tau_edges = np.logspace(np.log10(tau_values[0]), np.log10(tau_values[-1]), len(tau_values)+1)\n",
    "y_edges = np.arange(len(labels)+1)\n",
    "\n",
    "# 3.3. Dibuja\n",
    "plt.figure(figsize=(8,5))\n",
    "mesh = plt.pcolormesh(tau_edges, y_edges, E, norm=LogNorm(vmin=E.min()+1e-6, vmax=E.max()),\n",
    "                      cmap=\"magma\")\n",
    "plt.xscale(\"log\")\n",
    "plt.yticks(np.arange(0.5, len(labels)+0.5), labels)\n",
    "plt.xlabel(r\"$\\log\\tau$\")\n",
    "plt.ylabel(\"Truncamientos consecutivos\")\n",
    "plt.title(\"Heatmap de error relativo\")\n",
    "plt.colorbar(mesh, label=\"Error relativo (%)\")\n",
    "plt.savefig(\"figuras/heatmap_error.pdf\", bbox_inches=\"tight\", dpi=300)\n",
    "plt.show()"
   ]

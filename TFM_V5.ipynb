    "##############################################################################\n",
    "# 8. Función de Correlación G(t) CORREGIDA\n",
    "##############################################################################\n",
    "\n",
    "dr = rho_nodes[1] - rho_nodes[0]\n",
    "dz = z_nodes[1] - z_nodes[0]\n",
    "\n",
    "# Factor de forma dipolar f(ρ,z) en la malla (mismo que antes, pero sin f0)\n",
    "R2 = rho_nodes**2\n",

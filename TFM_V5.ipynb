    "def R_func(alpha, rho):\n",
    "    \"\"\"\n",
    "    Calcula R_n(rho) = J0(alpha_n * rho) normalizados con la norma analítica\n",
    "      ∫₀ᴿ J₀²(αₙ ρ) ρ dρ = (R²/2)[J₀²(αₙR) + J₁²(αₙR)].\n",
    "\n",
    "    Args:\n",
    "        alpha_n: array de raíces αₙ, shape (n_modes,)\n",
    "        rho_vals: escalar o array de posiciones radiales, shape (m,)\n",
    "\n",
    "    Returns:\n",
    "        R_normed: array (n_modes, m) de los modos normalizados\n",
    "        norms:    array (n_modes,) con el valor exacto de la norma\n",
    "    \"\"\"\n",
    "   # 1) Aseguramos que alpha_n y rho_vals sean arrays 1D\n",
    "    alpha_arr = np.atleast_1d(alpha)              # shape (n_modes,)\n",
    "    rho_arr   = np.atleast_1d(rho)             # shape (m,)\n",
    "\n",
    "    # 2) Creamos vistas 2D para broadcasting\n",
    "    alpha = alpha_arr.reshape(-1, 1)                # (n_modes, 1)\n",
    "    rho   = rho_arr.reshape(1, -1)                  # (1, m)\n",
    "\n",
    "    # 3) Evaluamos el modo sin normalizar\n",
    "    R_matrix = jv(0, alpha * rho)                   # (n_modes, m)\n",
    "\n",
    "    # 4) Calculamos la norma analítica usando alpha_arr (no el escalar viejo)\n",
    "    J0R = jv(0, alpha_arr * R)                      # (n_modes,)\n",
    "    J1R = jv(1, alpha_arr * R)                    # (n_modes,)\n",
    "    norms = 0.5 * R**2 * (J0R**2 + J1R**2)           # (n_modes,)\n",
    "\n",
    "    # 5) Aseguramos que norms sea un array 1D\n",
    "    norms = np.atleast_1d(norms)\n",
    "\n",
    "    # 6) Factor de normalización\n",
    "    N = 1.0 / np.sqrt(norms)                        # (n_modes,)\n",
    "\n",
    "    # 7) Aplicamos normalización por filas\n",
    "    R_normed = N[:, None] * R_matrix                # (n_modes, m)\n",
    "\n",
    "    return R_normed, np.sqrt(norms)"
   ]
  },

   "source": [
    "# -----------------------------------------------------------------------------\n",
    "# 5. Malla temporal y pre-cálculo de f(ρ,z') y medida ρ dρ dz' (independientes de D1)\n",
    "# -----------------------------------------------------------------------------\n",
    "# 5.1 Nodos de integración en rho y z' para G(t):\n",
    "N_quad = 1000\n",
    "rho_nodes = np.linspace(0.0, R, N_quad)   # [0, R]\n",
    "z_nodes  = np.linspace(0.0, L, N_quad)    # [0, L] = z' en el modelo de dos regiones\n",
    "\n",
    "dr = rho_nodes[1] - rho_nodes[0]\n",
    "dz = z_nodes[1]  - z_nodes[0]\n",
    "\n",
    "# 5.2 Factor dipolar f(ρ,z') en la malla (Nr, Nz)\n",
    "#     Distancia al NV: z' + d\n",
    "R2 = rho_nodes**2\n",
    "Z2 = (z_nodes + d + 1e-30)**2   # pequeño desplazamiento para evitar división por cero\n",
    "f_mat = (3 * Z2[None, :] - R2[:, None]) / (R2[:, None] + Z2[None, :])**2.5  # shape (Nr, Nz)\n",
    "\n",
    "# 5.3 Medida cilíndrica ρ dρ dz'\n",
    "measure = rho_nodes[:, None] * dr * dz    # shape (Nr, 1)\n",
    "\n",
    "# 5.4 Matriz F(ρ,z') = ρ dρ dz' f(ρ,z')\n",
    "F = measure * f_mat                       # shape (Nr, Nz)\n",
    "\n",
    "# 5.5 Vector de tiempos t en los que se evaluará G(t)\n",
    "t_values = np.logspace(-3, 4, N_quad)     # (N_quad,)"
   ]

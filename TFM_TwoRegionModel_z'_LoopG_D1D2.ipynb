   "source": [
    "# -----------------------------------------------------------------------------\n",
    "# 1. Parámetros físicos (en nm y unidades compatibles)\n",
    "# -----------------------------------------------------------------------------\n",
    "d = 15               # nm Profundidad de NV\n",
    "D2 = 2e3             # nm²/us (región volumétrica)\n",
    "L = R = 5*d        # nm (altura total), nm (radio del cilindro)\n",
    "varkappa = 0.0       # nm/us\n",
    "z_c = 0.75/d*L          # nm\n",
    "n_modes_radial = 100  # Número de modos radiales\n",
    "m_max = 100           # Número de modos axiales por modo radial\n",
    "N_z = N_r = 15000    # Número de nodos en z y rho"
   ]
  },
  {
   "cell_type": "code",

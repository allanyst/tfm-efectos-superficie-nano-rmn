   "source": [
    "# -----------------------------------------------------------------------------\n",
    "# 2. Cálculo de D_eff (promedio armónico), que también se usa en tau = t * D_eff / d^2\n",
    "# -----------------------------------------------------------------------------\n",
    "def D_eff_tworegion(D1, D2, z_c, L):\n",
    "    L1, L2 = z_c, L - z_c\n",
    "    return (L1 + L2) / (L1/D1 + L2/D2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "65151323-5031-4a9f-862b-1a1c3012e8cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# -----------------------------------------------------------------------------\n",
    "# 3. Definición de funciones compartidas:\n",
    "#    - robin_eq(alpha): ecuación trascendental radial con parámetro varkappa\n",
    "#    - R_func(alpha_array, rho_array): calcula los modos radiales J0(alpha_n * rho) normalizados\n",
    "#    - build_system(n): ensambla y diagonaliza la parte axial para un modo radial n\n",
    "# -----------------------------------------------------------------------------\n",
    "def robin_eq(alpha, varkappa, D_eff):\n",
    "    \"\"\"\n",
    "    Ecuación trascendental radial para hallar raíces alpha_n:\n",
    "       alpha * J1(alpha*R) - (varkappa / D_eff) * J0(alpha*R) = 0.\n",
    "    \"\"\"\n",
    "    return alpha * jv(1, alpha * R) - (varkappa / D_eff) * jv(0, alpha * R)\n",
    "\n",
    "def find_alpha_roots(varkappa, D_eff, n_roots=n_modes_radial, step=1e-4):\n",
    "    \"\"\"\n",
    "    Encuentra las primeras `n_roots` raíces alpha_n de robin_eq(alpha)=0\n",
    "    en intervalos [0, ...] usando brentq y un paso `step`.\n",
    "    \"\"\"\n",
    "    alpha_roots = []\n",
    "    alpha_current = 0.0\n",
    "    while len(alpha_roots) < n_roots:\n",
    "        try:\n",
    "            root = brentq(lambda a: robin_eq(a, varkappa, D_eff),\n",
    "                          alpha_current, alpha_current + step, xtol=1e-6)\n",
    "            alpha_roots.append(root)\n",
    "            alpha_current = root + step\n",
    "        except ValueError:\n",
    "            alpha_current += step\n",
    "    return np.array(alpha_roots)\n",
    "\n",
    "def R_func(alpha_arr, rho_arr):\n",
    "    \"\"\"\n",
    "    Calcula los modos radiales normalizados R_n(rho) = J0(alpha_n * rho)/sqrt(norm_n).\n",
    "    Retorna:\n",
    "      - R_normed: array con forma (n_modes_radial, len(rho_arr))\n",
    "      - norms: vector con las normas (no se usa más adelante, pero lo dejamos para consistencia)\n",
    "    \"\"\"\n",
    "    # alpha_arr: (n_modes_radial,)\n",
    "    # rho_arr: (N_rhos,)\n",
    "    alpha = alpha_arr.reshape(-1, 1)   # forma (n_modes_radial, 1)\n",
    "    rho = rho_arr.reshape(1, -1)       # forma (1, N_rhos)\n",
    "    R_matrix = jv(0, alpha * rho)      # (n_modes_radial, N_rhos)\n",
    "\n",
    "    # Cálculo de normas analíticas: norms[n] = sqrt{ \\int_0^R rho J0^2(alpha_n rho) d rho }\n",
    "    J0R = jv(0, alpha_arr * R)  # (n_modes_radial,)\n",
    "    J1R = jv(1, alpha_arr * R)  # (n_modes_radial,)\n",
    "    norms = 0.5 * R ** 2 * (J0R**2 + J1R**2)  # (n_modes_radial,)\n",
    "    norms = np.atleast_1d(norms)\n",
    "    Nnorm = 1.0 / np.sqrt(norms)  # factor de normalización\n",
    "\n",
    "    R_normed = Nnorm[:, None] * R_matrix  # (n_modes_radial, N_rhos)\n",
    "    return R_normed, np.sqrt(norms)\n",
    "\n",
    "def transcendental_eq(Lambda, alpha_n, kappa, z_c, D1, D2):\n",
    "    beta_1_sq = np.abs(Lambda**2 - alpha_n**2 * D1) / D1\n",
    "    beta_2_sq = np.abs(Lambda**2 - alpha_n**2 * D2) / D2\n",
    "    \n",
    "    # if beta_1_sq < 0 or beta_2_sq < 0:\n",
    "    #     return np.inf  # Evitar raíces complejas\n",
    "    \n",
    "    beta_1 = np.sqrt(beta_1_sq)\n",
    "    beta_2 = np.sqrt(beta_2_sq)\n",
    "\n",
    "    gamma=D2*beta_2*np.sin(beta_2*(L-z_c))-kappa*np.cos(beta_2*(L-z_c))\n",
    "    theta=D2*beta_2*np.cos(beta_2*(L-z_c))+kappa*np.sin(beta_2*(L-z_c))\n",
    "    \n",
    "    # return (D1 * beta_1*np.cos(beta_2*(L-z_c))-kappa*D2*beta_2/D1/beta_1*np.sin(beta_2*(L-z_c))) * np.sin(beta_1 * z_c) + (kappa**beta_1*np.cos(beta_2*(L-z_c))+D2 * beta_2*np.sin(beta_2 * (L - z_c))) * np.cos(beta_1 * z_c)\n",
    "    return (kappa*D1*beta_1*theta-D2*beta_2*D1*beta_1*gamma)*np.cos(beta_1*z_c)-(D1**2*beta_1**2*theta+kappa*beta_2*D2*gamma)*np.sin(beta_1*z_c)\n",
    "\n",
    "def find_lambda_roots(alpha, kappa, z_c, D1, D2, m_roots=m_max, step=1e-2):\n",
    "    Lambda_min = alpha * np.sqrt(D2)\n",
    "    roots = []\n",
    "    \n",
    "    Lambda_current = Lambda_min\n",
    "    while len(roots) < m_max:\n",
    "        # Buscar raíces en el intervalo [Lambda_current, Lambda_current + step]\n",
    "        try:\n",
    "            root = brentq(transcendental_eq, Lambda_current, Lambda_current + step,\n",
    "                           args=(alpha,kappa,z_c, D1, D2), xtol=1e-6)\n",
    "            roots.append(root**2)\n",
    "            Lambda_current = root + step  # Mover el inicio para la próxima búsqueda\n",
    "        except ValueError:\n",
    "            Lambda_current += step\n",
    "    \n",
    "    return np.array(roots[:m_max])  # Devuelve hasta m_max raíces\n",
    "\n",
    "# Definir fz_raw vectorizado\n",
    "def fz_raw(z_val, z_c, D1, D2, kappa, alpha_n, eigenvalues_ax, n, m):\n",
    "    z = np.array(z_val, dtype=float)\n",
    "    # modos\n",
    "    r_mode = alpha_n[n]\n",
    "    z_mode = eigenvalues_ax[n][m]\n",
    "    \n",
    "    beta_1 = np.sqrt(np.abs(z_mode - r_mode**2 * D1) / D1)\n",
    "    beta_2 = np.sqrt(np.abs(z_mode - r_mode**2 * D2) / D2)\n",
    "    \n",
    "    # expresiones para cada región\n",
    "    expr1 = np.cos(beta_1 * (z)) + (kappa / (D1 * beta_1+1e-30)) * np.sin(beta_1 * (z))\n",
    "    expr2 = (np.cos(beta_1 * z_c) + (kappa / (D1 * beta_1+1e-30)) * np.sin(beta_1 * z_c)) * \\\n",
    "            ((np.sin(beta_2*(L-z_c))-kappa*np.cos(beta_2*(L-z_c)))/(np.cos(beta_2*(L-z_c))+kappa*np.sin(beta_2*(L-z_c)))*\\\n",
    "            np.sin(beta_2 * (z - z_c)) + np.cos(beta_2 * (z - z_c)))\n",
    "    \n",
    "    # seleccionar por región\n",
    "    return np.where(z <= z_c, expr1, expr2)\n",
    "    \n",
    "def T(t, lam):\n",
    "    return np.exp(-np.abs(lam) * t)\n",
    "\n",
    "def compute_P_vec(t, eigenvalues_ax, Z_tens, R0_mat, A_nm):\n",
    "    \"\"\"\n",
    "    Computa P(ρ,z,t) más rápido usando matrices precalculadas.\n",
    "\n",
    "    Parámetros:\n",
    "    - t: escalar de tiempo\n",
    "    - Z_tens: shape (Nz, n_modes_radial, m_max)\n",
    "    - R0_mat: shape (n_modes_radial, N_r)\n",
    "    - A_nm: coeficientes modales (n_modes_radial, m_max)\n",
    "\n",
    "    Devuelve:\n",
    "    - P: shape (Nz, Nr)\n",
    "    \"\"\"\n",
    "    T_decay = T(t, eigenvalues_ax)  # (n_modes, m_max)\n",
    "    W = A_nm * T_decay               # (n_modes, m_max)\n",
    "    B = np.sum(Z_tens * W[None, :, :], axis=2)  # (Nz, n_modes)\n",
    "    S = np.dot(R0_mat.T, B.T)  # (Nr, Nz)\n",
    "    return S.T # np.maximum(S.T, 0)"
   ]
  },

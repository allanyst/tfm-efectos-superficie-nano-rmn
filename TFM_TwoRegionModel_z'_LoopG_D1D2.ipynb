   "source": [
    "# --------------------------------------------------------\n",
    "# 7. Al terminar el bucle, combinamos todos los archivos temporales\n",
    "# --------------------------------------------------------\n",
    "print(\"→ Combinando archivos temporales en 'VariateD1_G_vs_t_tworegion_z'.dat' ...\")\n",
    "\n",
    "primero = True\n",
    "lista_Gcols = []\n",
    "\n",
    "for f in D_fraction_list:\n",
    "    temp_filename = os.path.join(\"data/temp_G_tworegion_z'_D\", f\"G_D1_{int(f*D2)}.dat\")\n",
    "    # Ahora le decimos a loadtxt que omita la cabecera (1 línea)\n",
    "    arr = np.loadtxt(temp_filename, skiprows=1)   # forma (N_quad, 2)\n",
    "\n",
    "    if primero:\n",
    "        t_col = arr[:, 0]   # extraemos el vector de tiempos\n",
    "        primero = False\n",
    "    G_col = arr[:, 1]       # extraemos la columna G(t) para este kappa\n",
    "    lista_Gcols.append(G_col)\n",
    "\n",
    "# Después seguimos exactamente igual:\n",
    "G_stack = np.vstack(lista_Gcols).T               # (N_quad, 8)\n",
    "output_data = np.column_stack([t_col, G_stack])  # (N_quad, 1 + 8)\n",
    "\n",
    "header_cols = ['Tiempo(s)'] + [f'G_D1{int(f*D2)}' for f in D_fraction_list]\n",
    "header_str = '   '.join(header_cols)\n",
    "\n",
    "np.savetxt(\n",
    "    \"data/VariateD1_G_vs_t_tworegion_z'.dat\",\n",
    "    output_data,\n",
    "    header=header_str,\n",
    "    fmt=\"%.9e\",\n",
    "    comments=''\n",
    ")\n",
    "\n",
    "print(\"→ Archivo final 'VariateD1_G_vs_t_tworegion_z'.dat' creado con columnas:\")\n",
    "print(\"   \", header_cols)"
   ]
  },

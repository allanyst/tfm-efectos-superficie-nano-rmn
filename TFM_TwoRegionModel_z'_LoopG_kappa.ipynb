   "source": [
    "# -----------------------------------------------------------------------------\n",
    "# 6. Bucle principal: para cada varkappa, calcular G(t) y guardarlo en un archivo temporal\n",
    "# -----------------------------------------------------------------------------\n",
    "for kapp in varkappa_list:\n",
    "    print(f\"--- Calculando G(t) para varkappa = {kapp} nm/s ---\")\n",
    "\n",
    "    # 6.1. Hallar raíces alpha_n (n_modes_radial valores)\n",
    "    alpha_n = find_alpha_roots(kapp, D_eff, n_roots=n_modes_radial, step=1e-4)\n",
    "\n",
    "    # 6.2. Modos radiales normalizados en nodos rho\n",
    "    R0_mat, _ = R_func(alpha_n, rho_nodes)  # (n_modes_radial, N_quad)\n",
    "\n",
    "    # 6.3. Autovalores axiales λ_{n,m}(κ)\n",
    "    eigenvalues_ax = Parallel(n_jobs=4, verbose=1)(\n",
    "        delayed(find_lambda_roots)(alpha, kapp, m_roots=m_max, step=1e-2)\n",
    "        for n, alpha in enumerate(alpha_n)\n",
    "    )\n",
    "    eigenvalues_ax = np.array(eigenvalues_ax)   # shape (n_modes_radial, m_max)\n",
    "    \n",
    "    # 6.4. Normalizar cada modo axial en z' (∫ Z^2 dz' = 1)\n",
    "    C_nm = np.zeros((n_modes_radial, m_max))\n",
    "    for n in range(n_modes_radial):\n",
    "        for m in range(m_max):\n",
    "            Z_vals = fz_raw(z_nodes, kapp, alpha_n, eigenvalues_ax, n, m)\n",
    "            integral = np.trapz(Z_vals**2, z_nodes)\n",
    "            C_nm[n, m] = 1.0 / np.sqrt(integral + 1e-30)  # evitar división por 0\n",
    "    \n",
    "    # Función de modo axial normalizado\n",
    "    def fz(z_val, kapp, alpha_n, eigenvalues_ax, n, m):\n",
    "        return C_nm[n, m] * fz_raw(z_val, kapp, alpha_n, eigenvalues_ax, n, m)\n",
    "\n",
    "    # 6.5. Construcción de Z_tens[j, n, m] = Z_{n,m}(z_nodes[j])\n",
    "    Z_tens = np.empty((N_quad, n_modes_radial, m_max))\n",
    "    for n in range(n_modes_radial):\n",
    "        for m in range(m_max):\n",
    "            Z_tens[:, n, m] = fz(z_nodes, kapp, alpha_n, eigenvalues_ax, n, m)\n",
    "\n",
    "    # -------------------------------------------------------------------------\n",
    "    # 6.6. Coeficientes de proyección de f sobre los modos: Cproj_{n,m}(κ)\n",
    "    #      Cproj_nm = ∫ ρ dρ dz' f(ρ,z') R_n(ρ) Z_{n,m}(z';κ)\n",
    "    #      → Discretizado usando F(ρ,z') = ρ dρ dz' f(ρ,z')\n",
    "    # -------------------------------------------------------------------------\n",
    "    Cproj_nm = np.zeros((n_modes_radial, m_max))\n",
    "\n",
    "    for n in range(n_modes_radial):\n",
    "        # g_n(z_k) = ∑_i R_n(ρ_i) F(ρ_i, z_k)\n",
    "        g_n = np.dot(R0_mat[n, :], F)   # (N_quad,)\n",
    "        for m in range(m_max):\n",
    "            # Cproj_nm[n,m] = ∑_k g_n(z_k) Z_{n,m}(z_k)\n",
    "            Cproj_nm[n, m] = np.dot(g_n, Z_tens[:, n, m])\n",
    "\n",
    "    # -------------------------------------------------------------------------\n",
    "    # 6.7. Cálculo de G(t; κ) con la suma espectral\n",
    "    #      G(t) = (5 / 16π) * ∑_{n,m} [Cproj_nm(n,m)]² e^{-λ_{nm}(κ) t}\n",
    "    # -------------------------------------------------------------------------\n",
    "    G_values = np.zeros_like(t_values)\n",
    "    for i, t_val in enumerate(t_values):\n",
    "        T_decay = T(t_val, eigenvalues_ax)          # shape (n_modes_radial, m_max)\n",
    "        G_values[i] = (5.0 / (16.0 * np.pi)) * np.sum((Cproj_nm**2) * T_decay)\n",
    "\n",
    "    # -----------------------------------------------------------------------------\n",
    "    # 6.8. Guardar G_values en un archivo temporal y liberar memoria\n",
    "    # -----------------------------------------------------------------------------\n",
    "    temp_filename = os.path.join(\"data/temp_G_tworegion_z'\", f\"G_kappa_{kapp}.dat\")\n",
    "    data_to_save  = np.column_stack([t_values, G_values])  # (N_quad, 2)\n",
    "    header_str    = \"Tiempo(s)   G_k{}\".format(kapp)\n",
    "\n",
    "    np.savetxt(\n",
    "        temp_filename,\n",
    "        data_to_save,\n",
    "        header=header_str,\n",
    "        fmt=\"%.9e\",\n",
    "        comments=''\n",
    "    )\n",
    "\n",
    "    # Liberamos G_values inmediatamente\n",
    "    del G_values\n",
    "    del data_to_save\n",
    "\n",
    "    print(f\"  → Guardado temporal en '{temp_filename}' y liberado G_values.\\n\")\n"
   ]
  },


 "cells": [
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c90295c4",
   "metadata": {},
   "outputs": [],
   "source": [
    "import time_dependent_accumulation_surface as tda\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0d691c95",
   "metadata": {},
   "outputs": [],
   "source": [
    "from tqdm import tqdm\n",
    "\n",
    "d = 1.0          # nm (offset desde el origen al fondo del cilindro)\n",
    "R = L = 5.0*d    # nm\n",
    "D = 1.0          # nm^2 / µs\n",
    "m_max = 500\n",
    "p_max = 500\n",
    "n_rho = 500\n",
    "n_z = 500\n",
    "\n",
    "modes = tda.precompute_modes_gauss(R, L, d, D, m_max, p_max,n_rho=n_rho,n_z=n_z)\n",
    "\n",
    "# ----- parámetros -----\n",
    "dim_factor = np.arange(0.001, 50.02, 0.1)\n",
    "R_vals = dim_factor * d\n",
    "L_vals = dim_factor * d\n",
    "\n",
    "NR = len(R_vals)\n",
    "NL = len(L_vals)\n",
    "\n",
    "G_surf_inf_var = np.zeros((NR, NL))\n",
    "\n",
    "# ----- función para evaluar una fila -----\n",
    "def compute_row(i):\n",
    "    R = dim_factor[i] * d\n",
    "    row = np.zeros(NL)\n",
    "\n",
    "    surface_cache = {}  # cache LOCAL por fila\n",
    "\n",
    "    for j in range(NL):\n",
    "        L = dim_factor[j] * d\n",
    "\n",
    "        if L not in surface_cache:\n",
    "            surface_cache[L] = tda.precompute_surface_integrals(\n",
    "                R, L, d, modes,\n",
    "                n_rho=n_rho,\n",
    "                n_z=n_z\n",
    "            )\n",
    "\n",
    "        surface_ints = surface_cache[L]\n",
    "        surf_modes =  tda.precompute_surface_modes(R, L, d, modes, surface_ints)\n",
    "        row[j] =  tda.G_surface_infty_from_modes(modes, surf_modes)\n",
    "\n",
    "    return i, row\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "920f5446",
   "metadata": {},
   "outputs": [],
   "source": [
    "from joblib import Parallel, delayed\n",
    "# ----- paralelización -----\n",
    "results = Parallel(n_jobs=4,verbose=1)(\n",
    "    delayed(compute_row)(i)\n",
    "    for i in tqdm(range(NR))\n",
    ")\n",
    "\n",
    "for i, row in results:\n",
    "    G_surf_inf_var[i,:] = row\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bd11f65a",
   "metadata": {},
   "outputs": [],
   "source": [
    "np.savetxt(\"data/G_matrix.dat\", G_surf_inf_var)\n",
    "np.savetxt(\"data/R_vals.dat\", R_vals)\n",
    "np.savetxt(\"data/L_vals.dat\", L_vals)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fc437686",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.imshow(G_surf_inf_var, cmap='plasma', interpolation='nearest')\n",
    "\n",
    "# Add colorbar\n",
    "plt.colorbar()\n",
    "\n",
    "plt.title(\"Heatmap with color bar\")\n",
    "plt.show()"
   ]
  }
 ],
